# Skopíruj do .env a doplň vlastné hodnoty. .env do gitu NIKDY nepatrí.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrition_app

# Aspoň 32 znakov. Vygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-secret-min-32-chars

# Admin účet. V produkcii je povinný a heslo musí mať aspoň 12 znakov,
# inak sa server zámerne nespustí.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=zmen-toto-heslo-teraz

# Demo účet slúži len na vývoj - v produkcii sa ignoruje.
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=user123456

# Voliteľné
BCRYPT_ROUNDS=12
PG_POOL_MAX=5
# Domény, ktoré smú volať API z iného originu (oddelené čiarkou).
# Prázdne = povolené len požiadavky z vlastnej domény.
ALLOWED_ORIGINS=
